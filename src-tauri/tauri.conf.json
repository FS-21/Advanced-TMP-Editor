{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Advanced-TMP-Editor",
  "version": "2.1.0",
  "identifier": "com.fs-21.advancedtmpeditor",
  "build": {
    "beforeBuildCommand": "",
    "frontendDist": "../Build/PWA"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Advanced TMP Editor v2.1",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "FS-21",
    "copyright": "Copyright (C) 2026 FS-21",
    "targets": ["appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["tem", "sno", "urb", "ubn", "des", "lun"],
        "name": "Command & Conquer Theater TMP Tile",
        "description": "Westwood Studios Theater Terrain Tile",
        "role": "Editor"
      }
    ]
  }
}
